<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>Gole.Desktop</AssemblyName>
    <RootNamespace>Gole.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Gole.Desktop.Tests" />
    <ProjectReference Include="../Gole.Core/Gole.Core.csproj" />
    <ProjectReference Include="../Gole.Infrastructure/Gole.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
    <EmbeddedResource Include="Audio/water-drops.wav" LogicalName="Gole.Desktop.Audio.water-drops.wav" />
  </ItemGroup>
</Project>
